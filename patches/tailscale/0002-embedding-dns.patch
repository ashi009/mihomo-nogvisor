 ipn/ipnlocal/local.go            |  1 +
 net/dnscache/dnscache.go         |  9 ++++--
 net/dnscache/export.go           | 12 ++++++++
 net/dnscache/lookup_hook_test.go | 47 ++++++++++++++++++++++++++++++++
 net/netcheck/netcheck.go         | 24 ++++++----------
 net/tsdial/tsdial.go             | 24 +++++++++++-----
