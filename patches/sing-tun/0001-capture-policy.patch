-			if rule.Priority >= ruleStart && rule.Priority <= ruleEnd || (t.options.AutoRedirectMarkMode && rule.Priority == t.options.IPRoute2AutoRedirectFallbackRuleIndex) {
+			if t.options.CapturePolicy != nil {
+				ruleEnd = ruleStart + 2
