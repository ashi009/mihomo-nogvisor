diff --git a/tun_linux.go b/tun_linux.go
index 3d0dd3f..57c1961 100644
--- a/tun_linux.go
+++ b/tun_linux.go
@@ -588,6 +588,9 @@ func (t *NativeTun) rules() []*netlink.Rule {
 			it.Family = unix.AF_INET6
