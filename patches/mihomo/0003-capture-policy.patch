From d63ad1fafaec804ed8e575dd65621ef2c92e32d3 Mon Sep 17 00:00:00 2001
From: rebase <rebase@local>
Date: Mon, 9 Nov 2026 05:48:18 +0800
Subject: [PATCH] listener: pass the scoped capture policy to sing-tun

Unrestricted auto-route would capture traffic excluded by our router
policy. Decode and validate capture-policy, pass it to sing-tun, and
include it in listener equality so policy changes recreate the listener.

Require nftables and mark-based routing for scoped interception. Reject
incompatible DNS, IPv6 and global routing-mark settings before startup.
The policy values remain in Jsonnet rather than in this hook.
---
 config/config.go            | 32 +++++++++++++++++++++++++-------
 listener/config/tun.go      | 20 +++++++++++++-------
 listener/sing_tun/server.go |  6 +++++-
 3 files changed, 43 insertions(+), 15 deletions(-)

diff --git a/config/config.go b/config/config.go
index 2a940e9..f591c55 100644
--- a/config/config.go
+++ b/config/config.go
@@ -4,6 +4,7 @@ import (
 	"errors"
 	"fmt"
 	"github.com/metacubex/mihomo/component/tailnet"
+	tun "github.com/metacubex/sing-tun"
 	"net"
 	"net/netip"
 	"net/url"
@@ -279,13 +280,14 @@ type RawNTP struct {
 }
 
 type RawTun struct {
-	Enable              bool       `yaml:"enable" json:"enable"`
-	Device              string     `yaml:"device" json:"device"`
-	Stack               C.TUNStack `yaml:"stack" json:"stack"`
-	DNSMode             string     `yaml:"dns-mode" json:"dns-mode"`
-	DNSHijack           []string   `yaml:"dns-hijack" json:"dns-hijack"`
-	AutoRoute           bool       `yaml:"auto-route" json:"auto-route"`
-	AutoDetectInterface bool       `yaml:"auto-detect-interface" json:"auto-detect-interface"`
+	CapturePolicy       *tun.CapturePolicy `yaml:"capture-policy"`
+	Enable              bool               `yaml:"enable" json:"enable"`
+	Device              string             `yaml:"device" json:"device"`
+	Stack               C.TUNStack         `yaml:"stack" json:"stack"`
+	DNSMode             string             `yaml:"dns-mode" json:"dns-mode"`
+	DNSHijack           []string           `yaml:"dns-hijack" json:"dns-hijack"`
+	AutoRoute           bool               `yaml:"auto-route" json:"auto-route"`
+	AutoDetectInterface bool               `yaml:"auto-detect-interface" json:"auto-detect-interface"`
 
 	MTU        uint32 `yaml:"mtu" json:"mtu,omitempty"`
 	GSO        bool   `yaml:"gso" json:"gso,omitempty"`
@@ -1712,6 +1714,21 @@ func parseIPV6(rawCfg *RawConfig) {
 }
 
 func parseTun(rawTun RawTun, dns *DNS, general *General) error {
+	if err := rawTun.CapturePolicy.Validate(); err != nil {
+		return err
+	}
+	if rawTun.CapturePolicy != nil {
+		host, port, err := net.SplitHostPort(dns.Listen)
+		if err != nil || !dns.Enable || (host != "" && host != "0.0.0.0" && host != "::") || port != fmt.Sprint(rawTun.CapturePolicy.DNSPort) {
+			return fmt.Errorf("capture-policy requires DNS listening on all addresses at dns-port")
+		}
+		if general.RoutingMark != 0 {
+			return fmt.Errorf("capture-policy owns routing-mark; remove the global setting")
+		}
+	}
+	if rawTun.CapturePolicy != nil && (!rawTun.AutoRoute || !rawTun.AutoRedirect || len(rawTun.Inet6Address) > 0) {
+		return fmt.Errorf("capture-policy requires auto-route, auto-redirect and IPv4-only TUN")
+	}
 	tunAddressPrefix := dns.FakeIPRange
 	if !tunAddressPrefix.IsValid() {
 		tunAddressPrefix = netip.MustParsePrefix("198.18.0.1/16")
@@ -1719,6 +1736,7 @@ func parseTun(rawTun RawTun, dns *DNS, general *General) error {
 	tunAddressPrefix = netip.PrefixFrom(tunAddressPrefix.Addr(), 30)
 
 	general.Tun = LC.Tun{
+		CapturePolicy:       rawTun.CapturePolicy,
 		Enable:              rawTun.Enable,
 		Device:              rawTun.Device,
 		Stack:               rawTun.Stack,
