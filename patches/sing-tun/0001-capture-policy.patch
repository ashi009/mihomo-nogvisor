+			if rule.Priority >= ruleStart && rule.Priority <= ruleEnd || (t.options.CapturePolicy == nil && t.options.AutoRedirectMarkMode && rule.Priority == t.options.IPRoute2AutoRedirectFallbackRuleIndex) {
