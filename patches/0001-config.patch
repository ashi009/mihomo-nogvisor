From: rebase <rebase@local>
Date: Mon, 9 Nov 2026 05:48:18 +0800
Subject: [PATCH] 0001-config

---
 config/config.go | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/config/config.go b/config/config.go
index f252a26..2a940e9 100644
--- a/config/config.go
+++ b/config/config.go
@@ -3,6 +3,7 @@ package config
 import (
 	"errors"
 	"fmt"
+	"github.com/metacubex/mihomo/component/tailnet"
 	"net"
 	"net/netip"
 	"net/url"
@@ -199,6 +200,7 @@ type TLS struct {
 
 // Config is mihomo config manager
 type Config struct {
+	Tailnet       tailnet.Config
 	General       *General
 	Controller    *Controller
 	Experimental  *Experimental
@@ -409,6 +411,7 @@ type RawTLS struct {
 }
 
 type RawConfig struct {
+	Tailnet                       tailnet.Config          `yaml:"tailnet"`
 	Port                          int                     `yaml:"port" json:"port"`
 	SocksPort                     int                     `yaml:"socks-port" json:"socks-port"`
 	RedirPort                     int                     `yaml:"redir-port" json:"redir-port"`
@@ -638,6 +641,11 @@ func UnmarshalRawConfig(buf []byte) (*RawConfig, error) {
 
 func ParseRawConfig(rawCfg *RawConfig) (*Config, error) {
 	config := &Config{}
+	tc, err := tailnet.Normalize(rawCfg.Tailnet)
+	if err != nil {
+		return nil, err
+	}
+	config.Tailnet = tc
 	log.Infoln("Start initial configuration in progress") //Segment finished in xxm
 	startTime := time.Now()
 
