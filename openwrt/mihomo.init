#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/mihomo
DATA=/etc/mihomo
CONFIG=$DATA/config.yaml
RUNNING=$DATA/running.yaml

check_config() {
	local output status
	output=$("$PROG" -t -d "$DATA" -f "$CONFIG" 2>&1)
	status=$?
	printf '%s\n' "$output" | logger -t mihomo-check
	return "$status"
}

start_service() {
	[ -x "$PROG" ] && [ -s "$CONFIG" ] || return 1
	check_config || return 1
	/usr/libexec/mihomo-firewall apply || return 1
	umask 077
	cp "$CONFIG" "$RUNNING.new" && mv "$RUNNING.new" "$RUNNING" || return 1
	procd_open_instance core
	procd_set_param command "$PROG" -service -d "$DATA" -f "$RUNNING"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

reload_service() {
	# A malformed replacement must not stop the working service. Service-level
	# reload restarts; dashboard rule/proxy reloads retain the embedded tailnet.
	check_config || return 1
	stop
	start
}

service_stopped() {
	[ -s "$RUNNING" ] || return 0
	# procd may return while the process is still handling SIGTERM.
	local attempt output
	for attempt in $(seq 1 20); do
		output=$("$PROG" -cleanup -d "$DATA" -f "$RUNNING" 2>&1) && return 0
		sleep 1
	done
	printf '%s\n' "$output" | logger -t mihomo
	return 1
}
