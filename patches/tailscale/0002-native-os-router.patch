+// maskof returns the mask of the given prefix in big endian bytes.
+func maskof(pfx netip.Prefix) []byte {
+	mask := make([]byte, 4)
+	binary.BigEndian.PutUint32(mask, ^(uint32(0xffff_ffff) >> pfx.Bits()))
+	return mask
+}
